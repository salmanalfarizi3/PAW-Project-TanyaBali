<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Temukan informasi wisata, pura, dan kuliner khas Bali bersama TanyaBali.">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">
      <img src="/logo.png" alt="Logo TanyaBali">
      <span>Tanya<span class="brand-accent">Bali</span></span>
    </a>
    <button class="mobile-menu" id="mobileMenu" aria-label="Buka menu">☰</button>
    <nav class="main-nav" id="mainNav">
      <a class="active" href="/">Beranda</a>
      <a href="#jelajahi">Jelajahi</a>
      <a href="#tentang">Tentang</a>
      <a href="/referensi">Referensi</a>
    </nav>
    <div class="header-actions">
      <% if(currentUser){ %>
        <span class="user-greeting">Hai, <%= currentUser.name.split(' ')[0] %></span>
        <a class="btn btn-primary" href="/chatbot">Buka Chatbot</a>
        <form action="/logout" method="POST">
          <button class="btn btn-outline">Keluar</button>
        </form>
      <% }else{ %>
        <a class="btn btn-outline" href="/login">Masuk</a>
        <a class="btn btn-primary" href="/register">Daftar</a>
      <% } %>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-content">
        <span class="eyebrow light">PULAU DEWATA MENANTIMU</span>
        <h1>Temukan cerita<br>di setiap sudut <em>Bali.</em></h1>
        <p>Butuh rekomendasi tempat wisata, pura, atau kuliner lokal? TanyaBali siap menemani perjalananmu dengan informasi yang mudah ditemukan.</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-large" href="<%= currentUser?'/chatbot':'/login?next=%2Fchatbot' %>">Tanya TanyaBali ↗</a>
          <a class="text-link light-link" href="#jelajahi">Jelajahi destinasi ↓</a>
        </div>
        <div class="hero-note">
          <span class="status-dot"></span> Asisten informasi wisata Bali
        </div>
      </div>
      <div class="hero-caption">BALI, INDONESIA <span>—</span> THE ISLAND OF GODS</div>
    </section>

    <section class="intro section-wrap" id="tentang">
      <div>
        <span class="eyebrow">KENALI BALI LEBIH DEKAT</span>
        <h2>Perjalanan baik<br>dimulai dari <em>informasi.</em></h2>
      </div>
      <div class="intro-copy">
        <p>Bali punya banyak kisah untuk dijelajahi. Temukan informasi wisata, mengenal budaya, dan mencicipi kuliner khas dari berbagai daerah melalui percakapan sederhana.</p>
        <a class="text-link" href="<%= currentUser?'/chatbot':'/login?next=%2Fchatbot' %>">Mulai percakapan ↗</a>
      </div>
    </section>

    <section class="explore section-wrap" id="jelajahi">
      <div class="section-heading">
        <div>
          <span class="eyebrow">INSPIRASI PERJALANAN</span>
          <h2>Jelajahi keindahan <em>Bali.</em></h2>
        </div>
        <a class="text-link" href="<%= currentUser?'/chatbot':'/login?next=%2Fchatbot' %>">Tanya rekomendasi ↗</a>
      </div>
      <div class="category-grid">
        <a class="category-card beach" href="<%= currentUser?'/chatbot':'/login?next=%2Fchatbot' %>">
          <span class="category-number">01 / ALAM</span>
          <div>
            <h3>Pantai & Alam</h3>
            <p>Temukan pesisir, air terjun, dan lanskap tropis.</p>
          </div>
          <span class="circle-arrow">↗</span>
        </a>
        <a class="category-card culture" href="<%= currentUser?'/chatbot':'/login?next=%2Fchatbot' %>">
          <span class="category-number">02 / BUDAYA</span>
          <div>
            <h3>Pura & Budaya</h3>
            <p>Kenali warisan budaya dan tempat penuh makna.</p>
          </div>
          <span class="circle-arrow">↗</span>
        </a>
        <a class="category-card food" href="<%= currentUser?'/chatbot':'/login?next=%2Fchatbot' %>">
          <span class="category-number">03 / KULINER</span>
          <div>
            <h3>Kuliner Lokal</h3>
            <p>Jelajahi cita rasa khas dari berbagai daerah.</p>
          </div>
          <span class="circle-arrow">↗</span>
        </a>
      </div>
    </section>

    <section class="assistant-banner">
      <div class="assistant-copy">
        <span class="eyebrow light">TEMAN PERJALANAN DIGITALMU</span>
        <h2>Punya pertanyaan<br>tentang <em>Bali?</em></h2>
        <p>Ceritakan rencana perjalananmu. TanyaBali membantu menemukan informasi destinasi, pura, dan kuliner khas Bali.</p>
        <a class="btn btn-cream btn-large" href="<%= currentUser?'/chatbot':'/login?next=%2Fchatbot' %>">Mulai bertanya ↗</a>
      </div>
      <div class="assistant-art">
        <div class="chat-bubble bubble-one">Di mana lokasi Pura Tanah Lot?</div>
        <div class="chat-bubble bubble-two">Aku bantu carikan informasinya ✨</div>
        <div class="assistant-orb">tb.</div>
      </div>
    </section>

    <section class="destinations section-wrap">
      <div class="section-heading">
        <div>
          <span class="eyebrow">DATA INFORMASI</span>
          <h2>Temukan inspirasi <em>wisata.</em></h2>
        </div>
        <p class="muted-copy">Informasi destinasi yang tersedia dalam basis data TanyaBali.</p>
      </div>
      <% if(products&&products.length){ %>
        <div class="destination-grid">
          <% products.slice(0,6).forEach((item,i)=>{ %>
            <article class="destination-card">
              <div class="destination-image destination-image-<%= (i%3)+1 %>">
                <span><%= item.category||'WISATA BALI' %></span>
              </div>
              <div class="destination-info">
                <h3><%= item.name %></h3>
                <p>⌖ <%= item.category||'Bali, Indonesia' %></p>
                <div class="destination-bottom">
                  <strong><%= Number(item.price)>0?'Rp '+Number(item.price).toLocaleString('id-ID'):'Informasi wisata' %></strong>
                  <a href="<%= currentUser?'/chatbot':'/login?next=%2Fchatbot' %>">Tanya detail ↗</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% }else{ %>
        <div class="empty-state">
          <div class="empty-icon">✳</div>
          <h3>Informasi wisata segera hadir</h3>
          <p>Basis data destinasi belum terhubung atau belum berisi data.</p>
          <a class="text-link" href="<%= currentUser?'/chatbot':'/login?next=%2Fchatbot' %>">Tanya sekarang ↗</a>
        </div>
      <% } %>