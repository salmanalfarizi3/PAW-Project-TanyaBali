<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">
      <img src="/logo.png" alt="">
      <span>Tanya<span class="brand-accent">Bali</span></span>
    </a>
    <nav class="main-nav">
      <a href="/">Beranda</a>
      <a href="/chatbot">Chatbot</a>
      <a class="active" href="/info-tiket">Kelola Data</a>
    </nav>
    <div class="header-actions">
      <a class="btn btn-outline" href="/">Kembali</a>
    </div>
  </header>

  <main class="admin-wrap">
    <span class="eyebrow">PUSAT PENGETAHUAN CHATBOT</span>
    <h1 style="font:700 38px 'Playfair Display',serif;color:var(--green)">Data Wisata TanyaBali</h1>
    <p class="muted-copy">Kelola informasi destinasi, pura, kuliner, wilayah, harga, dan deskripsi yang digunakan chatbot.</p>

    <section class="glass-card">
      <h2 id="formTitle">Tambah informasi</h2>
      <form id="productForm">
        <input type="hidden" id="productId">
        
        <label class="form-label" for="name">Nama destinasi / kuliner</label>
        <input class="form-control" id="name" required maxlength="180">
        
        <label class="form-label" for="category">Wilayah / kategori</label>
        <input class="form-control" id="category" required maxlength="120" placeholder="Kabupaten Tabanan">
        
        <label class="form-label" for="price">Estimasi harga (Rp)</label>
        <input class="form-control" id="price" type="number" min="0" value="0" required>
        
        <label class="form-label" for="description">Deskripsi / informasi</label>
        <textarea class="form-control" id="description" rows="3"></textarea>
        
        <div style="display:flex;gap:10px;margin-top:18px">
          <button class="btn btn-primary" type="submit">Simpan data</button>
          <button class="btn btn-outline" type="button" id="cancelEdit">Bersihkan</button>
        </div>
        
        <p id="formMessage" class="muted-copy" aria-live="polite"></p>
      </form>
    </section>

    <h2 style="font:700 25px 'Playfair Display',serif;color:var(--green)">Data tersimpan</h2>
    <div style="overflow-x:auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Nama</th>
            <th>Wilayah / kategori</th>
            <th>Harga</th>
            <th>Deskripsi</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if(products&&products.length){
            products.forEach(p=>{ %>
              <tr>
                <td><strong><%= p.name %></strong></td>
                <td><%= p.category %></td>
                <td><%= Number(p.price)>0?'Rp '+Number(p.price).toLocaleString('id-ID'):'Tidak tersedia' %></td>
                <td><%= p.description||'-' %></td>
                <td>
                  <button class="btn btn-outline" type="button" data-edit='<%- JSON.stringify(p).replace(/'/g,'&#39;') %>'>Edit</button>
                  <button class="btn btn-outline" type="button" data-delete="<%= p.id %>">Hapus</button>
                </td>
              </tr>
            <%})
          }else{ %>
            <tr>
              <td colspan="5">Belum ada data.</td>
            </tr>
          <%}%>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    const form = document.getElementById('productForm'),
          id = document.getElementById('productId'),
          nameField = document.getElementById('name'),
          category = document.getElementById('category'),
          price = document.getElementById('price'),
          description = document.getElementById('description'),
          message = document.getElementById('formMessage');

    function clearForm() {
      form.reset();
      id.value = '';
      price.value = 0;
      document.getElementById('formTitle').textContent = 'Tambah informasi';
      message.textContent = '';
    }

    document.getElementById('cancelEdit').addEventListener('click', clearForm);

    document.querySelectorAll('[data-edit]').forEach(b => b.addEventListener('click', () => {
      const p = JSON.parse(b.dataset.edit);
      id.value = p.id;
      nameField.value = p.name;
      category.value = p.category;
      price.value = p.price;
      description.value = p.description || '';
      document.getElementById('formTitle').textContent = 'Edit informasi';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }));

    document.querySelectorAll('[data-delete]').forEach(b => b.addEventListener('click', async () => {
      if (!confirm('Hapus data ini?')) return;
      const r = await fetch('/api/produk/' + b.dataset.delete, { method: 'DELETE' });
      const d = await r.json();
      if (r.ok) location.reload();
      else alert(d.message || 'Gagal menghapus data');
    }));

    form.addEventListener('submit', async e => {
      e.preventDefault();
      const editing = Boolean(id.value),
            payload = {
              name: nameField.value.trim(),
              category: category.value.trim(),
              price: price.value,
              description: description.value.trim()
            };
      try {
        const r = await fetch(editing ? '/api/produk/' + id.value : '/api/produk', {
          method: editing ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const d = await r.json();
        if (!r.ok) throw new Error(d.message || 'Gagal menyimpan');
        message.textContent = d.message;
        location.reload();
      } catch (err) {
        message.textContent = err.message;
      }
    });
  </script>
</body>
</html>